rules_version = '2';
// Regeln NUR für die Datenbank "canopy" im Projekt chess-rng.
// Die Foil-Eleven-Datenbank "(default)" wird von diesen Regeln nicht berührt.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.canopyAdmin == true; }

    // Öffentliches Profil: Name, Avatar, Level, sichtbare Achievements. Jeder darf lesen (Freunde,
    // Bestenlisten), nur der Besitzer schreibt.
    // Der angezeigte Name muss ein Nutzername sein, der wirklich diesem Account gehört.
    function nameOk(uid) {
      return !('name' in request.resource.data)
        || (resource != null && request.resource.data.name == resource.data.get('name', null))
        || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.name)).data.uid == uid;
    }
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && nameOk(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Private Daten (Einstellungen, verknüpfte Spiel-Accounts). Nur der Besitzer.
    match /private/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Nutzernamen sind eindeutig: ein Dokument pro Name, das auf die uid zeigt.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Spielstände: saves/{uid}/games/{gameId}, dazu Versionen, die nie überschrieben werden dürfen
    // (Schutz gegen Datenverlust). Löschen nur durch den Besitzer selbst ("Account löschen").
    // Jede Speicherung muss genau auf der aktuellen Version aufbauen (version = alt + 1). So kann ein
    // Gerät mit veraltetem Stand nie still einen neueren überschreiben, ohne dass vorher gelesen werden muss.
    function nextVersion() {
      return request.resource.data.version == (resource == null ? 1 : resource.data.version + 1);
    }
    match /saves/{uid}/games/{gameId} {
      allow read, delete: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) && nextVersion()) || isAdmin();
      match /versions/{versionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow delete: if isOwner(uid) || isAdmin();
        allow update: if isAdmin();
      }
    }

    // Freundschaften: friendships/{a_b} mit a < b. Anfrage stellt einer, annehmen kann nur der andere,
    // beenden kann jeder der beiden. Lesen nur die beiden Beteiligten.
    match /friendships/{pid} {
      function newPair() {
        let m = request.resource.data.members;
        return m is list && m.size() == 2 && m[0] < m[1] && pid == m[0] + '_' + m[1];
      }
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && newPair()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['members', 'status', 'requestedBy', 'at']);
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Feedback zu Spielen und Prototypen: jeder Angemeldete darf abgeben, nur Admins lesen.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
